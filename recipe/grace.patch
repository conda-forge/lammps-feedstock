+  t_int_1d d_fc_BB2_wtl, d_fc_BB2_wtr;
+  t_int_1d d_fc_BB2_ct, d_fc_BB2_cf;
+  t_nn_1d d_fc_BB2_nof;
+  NNScalar fc_BB2_nl, fc_BB2_nr;
+
