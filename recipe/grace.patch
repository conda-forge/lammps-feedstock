+template<class DeviceType, typename NNScalarT, typename GeomScalarT>
+KOKKOS_INLINE_FUNCTION
+void PairGRACE2LCPUKokkos<DeviceType, NNScalarT, GeomScalarT>::operator() (TagPackReverseComm, const int& i) const
+{
