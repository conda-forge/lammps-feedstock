+
+    // Layer 2 per-atom
+    MemKK::realloc_kokkos(d_B0, "g2l:B0", natom, L2_nradmax, nlm);
+    MemKK::realloc_kokkos(d_YI_pair, "g2l:YI_pair", natom, L2_nradmax, n_yi_pairs);
