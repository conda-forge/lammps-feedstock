+/* ---------------------------------------------------------------------- */
+
+PairGRACE1LayerChunk::PairGRACE1LayerChunk(LAMMPS *lmp) : Pair(lmp)
+{
+  single_enable = 0;
+  restartinfo = 0;
+  one_coeff = 1;
+  manybody_flag = 1;
+
+  impl = new GRACE1LayerChunkImpl;
+
+  scale = nullptr;
+  chunksize = 4096;
+
+  total_timer.init();
+  data_timer.init();
+  model_timer.init();
+  tp_timer.init();
+
+  no_virial_fdotr_compute = 1;
+#ifndef MLPACE_DO_NOT_DISABLE_TFLOAT32
+  //disable tensor float 32 execution
+  tsl::enable_tensor_float_32_execution(false);
+#endif
+}
