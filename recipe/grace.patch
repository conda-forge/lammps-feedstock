+
+          // Forward pass: recompute hidden pre-activations
+          {
+            const int nout = edims(1);
+            for (int j = 0; j < nout; j++) {
+              NNScalar sum = 0.0;
+              const int i = il[ii + co];
+              for (int k = 0; k < nin0; k++)
