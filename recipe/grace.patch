+/* ---------------------------------------------------------------------- */
+
+void PairGRACE1LayerChunk::allocate()
+{
+  allocated = 1;
+  int n = atom->ntypes + 1;
+
+  memory->create(setflag, n, n, "pair:setflag");
+  memory->create(cutsq, n, n, "pair:cutsq");
+  memory->create(scale, n, n, "pair:scale");
+  map = new int[n];
+}
