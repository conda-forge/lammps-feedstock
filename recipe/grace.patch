+              const NNScalar d = cg(t) * out_adj(ii, k, o);
+              adj(ii, k, l) += d * fwd(ii, k, r);
+              adj(ii, k, r) += d * fwd(ii, k, l);
+            }
+          });
+      }
+      // ---- B1-6: ReverseFC_AA2 → d_AA_adj +=, d_A_adj += ----
