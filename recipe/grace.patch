+  }
+
+  if ((int)d_radial_basis.extent(0) < natom || (int)d_radial_basis.extent(1) < maxneigh_in) {
+    MemKK::realloc_kokkos(d_nearest, "g2l:nearest", natom, maxneigh_in);
