+      }
+      // ---- B1-7: ReverseProduct_AAA (AA1 ⊗ A) → d_AA1_adj, d_A_adj += ----
+      {
+        auto fl = d_AA1; auto fr = d_A; auto oa = d_AAA_adj;
+        auto la = d_AA1_adj; auto ra = d_A_adj;  // right=A, so adjoint goes to d_A_adj
