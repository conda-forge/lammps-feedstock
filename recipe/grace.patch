+          // dot = Σ_k d_ln[k] * ln_out[k]
+          NNScalar dot = 0.0;
+          for (int k = 0; k < n_out_ln; k++)
+            dot += ln_adj(ii, k) * ln_out(ii, k);
+
+          // dx[k] = rms_inv * (d_ln[k] * scale[k] - x[k] * dot * rms_inv / N)
+          for (int k = 0; k < n_out_ln; k++)
