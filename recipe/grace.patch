+}
+
+template<class DeviceType, typename NNScalarT, typename GeomScalarT>
+void PairGRACE2LCPUKokkos<DeviceType, NNScalarT, GeomScalarT>::unpack_reverse_comm_kokkos(int n, DAT::tdual_int_1d k_sendlist_in,
+                                                                 DAT::tdual_xfloat_1d &buf)
+{
