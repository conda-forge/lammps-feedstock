+  };
+  FCWeights fc_A1, fc_AA1, fc_AA2;
+
+  // Product CG metadata (AA, AAA, AAAA)
+  struct CGProduct {
+    std::vector<int> left_ind, right_ind, m_sum_ind;
+    std::vector<double> cg_coeff;
+    int n_output_funcs = 0;
+    int n_cg_terms = 0;
