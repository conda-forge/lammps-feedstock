+  GRACE::log_perf_stats(lmp, "grace/2layer/parallel", total_real_atoms_processed,
+                        total_compute_calls,
+                        {{"Total", total_timer.as_microseconds()},
+                         {"Data", data_timer.as_microseconds()},
+                         {"Comm", comm_timer.as_microseconds()},
+                         {"M1", model1_timer.as_microseconds()},
