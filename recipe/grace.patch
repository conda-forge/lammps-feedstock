+        REV_REDUCE_I1(AA, d_AA_adj)
+        REV_REDUCE_I1(AAA, d_AAA_adj)
+        REV_REDUCE_I1(AAAA, d_AAAA_adj)
+        #undef REV_REDUCE_I1
+      }
+
+      // ---- B1-5: ReverseProduct_AAAA (AA2 ⊗ AA2 self) → d_AA2_adj ----
+      {
+        auto fwd = d_AA2; auto out_adj = d_AAAA_adj; auto adj = d_AA2_adj;
